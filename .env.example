# Server
PORT=3000
BASE_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key   # Settings > API > service_role (keep secret)
SUPABASE_ANON_KEY=your-anon-key              # Settings > API > anon/public (safe to expose)

# Google OAuth (used for both Supabase Auth login AND Google Calendar connection)
# Get from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Calendar OAuth redirect URI — update to your deployed URL when live
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/auth/google/calendar/callback

# Email (Resend)
# Create account at resend.com, grab API key from dashboard
RESEND_API_KEY=your-resend-api-key
